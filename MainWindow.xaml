<Window x:Class="RxNeL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Rx | NeL"
        Width="1100" Height="780"
        MinWidth="980" MinHeight="700"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="218" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 侧边栏 -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,20,12,16">
                        <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource AccentBrush}">
                            <TextBlock Text="Rx" FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,1,0,0">
                            <TextBlock Text="Rx | NeL" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" />
                            <TextBlock Text="Roblox 启动器" FontSize="10"
                                       Foreground="{DynamicResource MutedBrush}" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Bottom" x:Name="SidebarVersion"
                               Margin="20,0,0,14" FontSize="10" FontFamily="Consolas"
                               Foreground="{DynamicResource MutedBrush}" />

                    <StackPanel x:Name="NavPanel" Margin="0,4,0,0" />
                </DockPanel>
            </Border>

            <!-- 主区域 -->
            <DockPanel Grid.Column="1">

                <Grid DockPanel.Dock="Top" Height="78" Background="Transparent"
                      MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="24,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" Style="{StaticResource H1}" />
                        <TextBlock x:Name="PageSubtitle" Style="{StaticResource Subtitle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox x:Name="ChannelBox" Style="{StaticResource InputCombo}"
                                  Width="132" Height="30" Margin="0,0,8,0" />
                        <Button x:Name="UpdateButton" Content="检查更新" Style="{StaticResource GhostButton}"
                                Height="30" Margin="0,0,8,0" Click="UpdateButton_Click" />
                        <Button x:Name="ThemeButton" Content="浅色" Style="{StaticResource GhostButton}"
                                Height="30" Margin="0,0,10,0" Click="ThemeButton_Click" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,8,8,0">
                        <Button x:Name="MinButton" Content="—" Style="{StaticResource WindowButton}" Click="MinButton_Click" />
                        <Button x:Name="MaxButton" Content="▢" Style="{StaticResource WindowButton}" Click="MaxButton_Click" />
                        <Button x:Name="CloseButton" Content="✕" Style="{StaticResource WindowButton}" Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>

                <Border DockPanel.Dock="Bottom" Background="{DynamicResource SidebarBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Rx | NeL" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,14,0" />

                        <TextBlock x:Name="StatusText" Grid.Column="1" FontSize="11"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextBrush}" />

                        <ProgressBar x:Name="StatusProgress" Grid.Column="2" Width="200" Height="4"
                                     Minimum="0" Maximum="100" Visibility="Collapsed"
                                     Foreground="{DynamicResource AccentBrush}"
                                     Background="{DynamicResource SurfaceAltBrush}" BorderThickness="0" />
                    </Grid>
                </Border>

                <ContentControl x:Name="PageHost" Margin="22,0,22,14" />
            </DockPanel>
            <!-- 启动遮罩：和主窗口同一个窗口，省掉第二个窗口 1 秒的初始化 -->
            <Border x:Name="LoadingOverlay" Grid.Column="0" Grid.ColumnSpan="2"
                    Background="{DynamicResource WindowBrush}"
                    Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid Width="96" Height="96">
                        <Ellipse Stroke="{DynamicResource BorderBrush}" StrokeThickness="6" Opacity="0.55" />
                        <Path Stroke="{DynamicResource AccentBrush}" StrokeThickness="6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 92,48 A 44,44 0 1 1 34,6">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="LoadingArc" CenterX="48" CenterY="48" />
                            </Path.RenderTransform>
                        </Path>
                        <Border Width="52" Height="52" CornerRadius="14" Background="{DynamicResource AccentBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Rx" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <TextBlock x:Name="LoadingStatus" Text="正在启动…" Margin="0,22,0,0"
                               FontSize="12" Foreground="{DynamicResource MutedBrush}"
                               HorizontalAlignment="Center" />

                    <Border Width="260" Height="4" CornerRadius="2" Margin="0,14,0,0"
                            Background="{DynamicResource SurfaceAltBrush}">
                        <Border x:Name="LoadingFill" Width="6" HorizontalAlignment="Left"
                                Background="{DynamicResource AccentBrush}" CornerRadius="2" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

    </Border>
</Window>
