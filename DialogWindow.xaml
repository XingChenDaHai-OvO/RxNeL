<Window x:Class="RxNeL.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rx | NeL"
        Width="460"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}">

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            Padding="22,18,22,16">
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" Text="提示" />

            <TextBlock x:Name="MessageText" Margin="0,10,0,0" FontSize="12" LineHeight="19"
                       TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Text="…" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="CancelButton" Content="取消" Style="{StaticResource GhostButton}"
                        Height="30" MinWidth="80" Margin="0,0,8,0" Click="Cancel_Click" />
                <Button x:Name="OkButton" Content="确定" Style="{StaticResource PrimaryButton}"
                        Height="30" MinWidth="80" Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
