<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="WindowColor">#070B0C</Color>
    <Color x:Key="SidebarColor">#0A1012</Color>
    <Color x:Key="SurfaceColor">#0C1214</Color>
    <Color x:Key="SurfaceAltColor">#111A1C</Color>
    <Color x:Key="BorderColor">#1C2A2A</Color>
    <Color x:Key="TextColor">#E4F2EC</Color>
    <Color x:Key="MutedColor">#6E8880</Color>
    <Color x:Key="AccentColor">#35E0A1</Color>
    <Color x:Key="AccentTextColor">#04150F</Color>
    <Color x:Key="AccentSoftColor">#10201C</Color>
    <Color x:Key="DangerColor">#FF6B6B</Color>
    <Color x:Key="SuccessColor">#35E0A1</Color>
    <Color x:Key="ShadowColor">#000000</Color>

    <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />

</ResourceDictionary>
