<UserControl x:Class="RxNeL.Views.SettingsHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="168" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="12" Padding="6,8" Margin="0,0,12,0"
                VerticalAlignment="Top">
            <StackPanel x:Name="SectionNav" />
        </Border>

        <ContentControl x:Name="SectionHost" Grid.Column="1" />
    </Grid>
</UserControl>
