<UserControl x:Class="RxNeL.Views.AppearanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="客户端字体" Style="{StaticResource Section}" Margin="0,0,0,10" />

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="字体" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox x:Name="FontBox" Style="{StaticResource InputCombo}" Width="300" Height="30"
                              Margin="0,0,8,0" SelectionChanged="FontBox_SelectionChanged" />
                    <Button Content="刷新列表" Style="{StaticResource GhostButton}" Click="Refresh_Click" />
                </StackPanel>

                <CheckBox x:Name="AllFamiliesCheck" Style="{StaticResource InputCheck}" Margin="0,12,0,0"
                          Content="同时替换全部字族（默认只改常用 UI 字体，CJK 回退字族始终保留）" />

                <TextBlock x:Name="PreviewText" Text="字体预览  Aa Bb Cc  0123  中文效果 Roblox"
                           FontSize="22" Margin="0,14,0,10" Foreground="{DynamicResource TextBrush}" />

                <StackPanel Orientation="Horizontal">
                    <Button Content="应用到客户端" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="Apply_Click" />
                    <Button Content="选择本地字体文件…" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Pick_Click" />
                    <Button Content="还原默认字体" Style="{StaticResource GhostButton}" Click="Restore_Click" />
                </StackPanel>

                <TextBlock x:Name="FontStatus" Style="{StaticResource Muted}" Margin="0,10,0,0" Text="尚未检测客户端字体" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="性能" Style="{StaticResource Section}" Margin="0,0,0,10" />

                <CheckBox x:Name="GpuCheck" Style="{StaticResource InputCheck}"
                          Content="让 Roblox 优先使用独立显卡（写入 UserGpuPreferences）" />

                <TextBlock x:Name="GpuStatus" Style="{StaticResource Muted}" Margin="0,8,0,0"
                           Text="适用于所有已安装的客户端版本，下次启动生效" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
