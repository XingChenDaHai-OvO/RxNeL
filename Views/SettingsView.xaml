<UserControl x:Class="RxNeL.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Card}">
            <StackPanel>

                <TextBlock Text="外观" Style="{StaticResource Section}" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="主题" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox x:Name="ThemeBox" Style="{StaticResource InputCombo}" Width="180" Height="30"
                              SelectionChanged="ThemeBox_SelectionChanged" />
                </StackPanel>

                <TextBlock Text="行为" Style="{StaticResource Section}" />
                <CheckBox x:Name="FastFlagCheck" Style="{StaticResource InputCheck}" Content="启用 FastFlags（启动时写入 ClientAppSettings.json）" />
                <CheckBox x:Name="RpcCheck" Style="{StaticResource InputCheck}" Content="启用 Discord Rich Presence（需要 Discord 客户端在运行）" />
                <CheckBox x:Name="ModsCheck" Style="{StaticResource InputCheck}" Content="启动时把模组目录覆盖进客户端" />
                <CheckBox x:Name="AutoUpdateCheck" Style="{StaticResource InputCheck}" Content="启动时自动检查客户端更新" />
                <CheckBox x:Name="MinimizeCheck" Style="{StaticResource InputCheck}" Content="启动游戏后最小化启动器" />
                <CheckBox x:Name="AppUpdateCheck" Style="{StaticResource InputCheck}" Content="启动时静默检查启动器更新" />

                <TextBlock Text="浮窗与热键" Style="{StaticResource Section}" />
                <CheckBox x:Name="HudCheck" Style="{StaticResource InputCheck}"
                          Content="显示常驻小窗（客户端版本 / 多开 / 账号数 / 运行时长）" />
                <CheckBox x:Name="HotkeyCheck" Style="{StaticResource InputCheck}"
                          Content="启用全局热键：Ctrl+Alt+R 唤起启动器，Ctrl+Alt+H 开关小窗（下次启动生效）" />

                <TextBlock Text="云后端（注册用，留空则纯本机注册）" Style="{StaticResource Section}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="项目 URL" Style="{StaticResource Muted}" Width="200" VerticalAlignment="Center" />
                    <TextBox x:Name="SupabaseUrlBox" Style="{StaticResource InputBox}" Width="360"
                             ToolTip="https://xxxx.supabase.co" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="anon key" Style="{StaticResource Muted}" Width="200" VerticalAlignment="Center" />
                    <PasswordBox x:Name="SupabaseKeyBox" Style="{StaticResource InputPassword}" Width="360" />
                </StackPanel>
                <TextBlock x:Name="BackendStatus" Style="{StaticResource Muted}" Margin="0,2,0,0"
                           Text="执行 db/profiles.sql 建表后可启用唯一性约束（邮箱 / Roblox ID / 机器码）" />

                <TextBlock Text="网络" Style="{StaticResource Section}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="代理（访问 Roblox 接口用）" Style="{StaticResource Muted}" Width="200"
                               VerticalAlignment="Center" />
                    <TextBox x:Name="ProxyBox" Style="{StaticResource InputBox}" Width="220"
                             ToolTip="例如 http://127.0.0.1:7890；留空直连" />
                    <Button Content="测试代理" Style="{StaticResource GhostButton}" Height="30"
                            Margin="8,0,0,0" Click="TestProxy_Click" />
                </StackPanel>
                <TextBlock x:Name="ProxyStatus" Style="{StaticResource Muted}" Margin="0,0,0,4"
                           Text="登录校验被墙时，填一个本地代理（Clash / v2rayN 的 HTTP 端口）就能通" />

                <TextBlock Text="语言" Style="{StaticResource Section}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Roblox 界面语言 (--rloc)" Style="{StaticResource Muted}" Width="200" VerticalAlignment="Center" />
                    <TextBox x:Name="RobloxLocaleBox" Style="{StaticResource InputBox}" Width="160" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="游戏内语言 (--gloc)" Style="{StaticResource Muted}" Width="200" VerticalAlignment="Center" />
                    <TextBox x:Name="GameLocaleBox" Style="{StaticResource InputBox}" Width="160" />
                </StackPanel>

                <TextBlock Text="Discord" Style="{StaticResource Section}" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Application ID" Style="{StaticResource Muted}" Width="200" VerticalAlignment="Center" />
                    <TextBox x:Name="DiscordIdBox" Style="{StaticResource InputBox}" Width="260" />
                </StackPanel>

                <TextBlock Text="高级：命令行模板" Style="{StaticResource Section}" />
                <TextBox x:Name="TemplateBox" Style="{StaticResource InputBox}" Height="70"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0">
                    <Run Text="占位符：" /><Run Text="{}{rawUri} {launchMode} {authTicket} {launchTime} {placeLauncherUrl} {browserTrackerId} {robloxLocale} {gameLocale} {channel}" />
                </TextBlock>

                <TextBlock Text="程序更新" Style="{StaticResource Section}" />
                <TextBlock x:Name="UpdateStatusText" Style="{StaticResource Muted}" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="GitHub 仓库 (owner/repo)" Style="{StaticResource Muted}" Width="200" VerticalAlignment="Center" />
                    <TextBox x:Name="UpdateRepoBox" Style="{StaticResource InputBox}" Width="220" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="自定义清单 URL（优先）" Style="{StaticResource Muted}" Width="200" VerticalAlignment="Center" />
                    <TextBox x:Name="UpdateManifestBox" Style="{StaticResource InputBox}" Width="360" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Content="保存设置" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="Save_Click" />
                    <Button Content="检查启动器更新" Style="{StaticResource GhostButton}" Click="CheckUpdate_Click" />
                </StackPanel>

            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
