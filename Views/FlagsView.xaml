<UserControl x:Class="RxNeL.Views.FlagsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource Card}">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="FastFlags 列表" Style="{StaticResource Section}" Margin="0,0,0,10" />

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <ComboBox x:Name="PresetBox" Style="{StaticResource InputCombo}" Width="260" Height="30" Margin="0,0,8,0" />
                <Button Content="应用预设" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="ApplyPreset_Click" />
                <Button Content="添加一项" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="AddRow_Click" />
                <Button Content="删除选中" Style="{StaticResource GhostButton}" Click="RemoveRow_Click" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="导入" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Import_Click" />
                <Button Content="导出" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Export_Click" />
                <Button Content="保存" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Save_Click" />
                <Button Content="保存并写入客户端" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="SaveApply_Click" />
                <Button Content="还原原始设置" Style="{StaticResource GhostButton}" Click="Restore_Click" />
            </StackPanel>

            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" Margin="0,10,0,0"
                       Text="写入后会生成 ClientSettings\ClientAppSettings.json（原文件备份为 *.rbxlite.bak）。部分 Flag 由 Roblox 服务端下发，本地覆盖可能无效。" />

            <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Flag 名称" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="10,0,0,0" />
                <TextBlock Grid.Column="1" Text="值（true / false / 数字 / 字符串）" FontSize="11"
                           Foreground="{DynamicResource MutedBrush}" Margin="10,0,0,0" />
            </Grid>

            <DataGrid x:Name="Grid" Style="{StaticResource PlainGrid}" CanUserAddRows="False"
                      HeadersVisibility="None" GridLinesVisibility="Horizontal" />
        </DockPanel>
    </Border>
</UserControl>
