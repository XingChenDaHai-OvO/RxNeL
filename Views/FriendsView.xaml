<UserControl x:Class="RxNeL.Views.FriendsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>

        <!-- 未注册：先绑定邮箱 + Roblox 账号 -->
        <Border x:Name="RegisterCard" Style="{StaticResource Card}" Visibility="Collapsed"
                VerticalAlignment="Center" HorizontalAlignment="Center" Width="520" Padding="24">
            <StackPanel>
                <TextBlock Text="注册后才能使用好友功能" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,14"
                           Text="先收邮箱验证码，再设一个独立密码；Roblox 只用来取用户名/昵称/头像。每台机器只能注册一次。" />

                <TextBlock Text="邮箱" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="EmailBox" Style="{StaticResource InputBox}" Height="30"
                             ToolTip="验证码会发到这个邮箱" />
                    <Button x:Name="SendCodeButton" Grid.Column="1" Content="发送验证码"
                            Style="{StaticResource GhostButton}" Height="30" MinWidth="104" Margin="8,0,0,0"
                            Click="SendCode_Click" />
                </Grid>

                <StackPanel x:Name="CodePanel">
                    <TextBlock Text="邮箱验证码" Style="{StaticResource Muted}" Margin="0,12,0,4" />
                    <TextBox x:Name="CodeBox" Style="{StaticResource InputBox}" Height="30"
                             MaxLength="8" ToolTip="邮件里的 6 位数字" />
                </StackPanel>

                <TextBlock Text="Roblox 用户名" Style="{StaticResource Muted}" Margin="0,12,0,4" />
                <TextBox x:Name="RobloxNameBox" Style="{StaticResource InputBox}" Height="30"
                         ToolTip="不是显示名，是 @ 后面那个唯一用户名" />

                <TextBlock x:Name="PasswordLabel" Text="启动器密码（与 Roblox 无关）" Style="{StaticResource Muted}"
                           Margin="0,12,0,4" />
                <PasswordBox x:Name="PasswordBox" Style="{StaticResource InputPassword}" Height="30"
                             ToolTip="至少 6 位；登录和记住你用，不会发给 Roblox" />

                <Button x:Name="RegisterButton" Content="完成注册"
                        Style="{StaticResource PrimaryButton}" Height="34"
                        Margin="0,16,0,0" Click="Register_Click" />

                <TextBlock x:Name="RegisterStatus" Style="{StaticResource Muted}" Margin="0,12,0,0"
                           TextWrapping="Wrap" />

                <TextBlock x:Name="BackendHint" Style="{StaticResource Muted}" Margin="0,6,0,0"
                           FontSize="10" TextWrapping="Wrap"
                           Text="未配置后端：将只在本机注册（设置 → 通用 → 云后端 可填 Supabase URL + anon key）" />

                <TextBlock x:Name="QuotaHint" Style="{StaticResource Muted}" Margin="0,4,0,0"
                           FontSize="10" TextWrapping="Wrap"
                           Text="发信走 Supabase 免费额度：每小时最多 2 封，用完后要等约 1 小时。"
                           Visibility="Collapsed" />

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center"
                               Text="已注册过想换号？" FontSize="11" />
                    <Button Content="清空本机注册" Style="{StaticResource GhostButton}" Height="26"
                            FontSize="11" Padding="10,2" Margin="8,0,0,0" Click="Reset_Click" />
                    <Button x:Name="SkipButton" Content="先用本机档案" Style="{StaticResource GhostButton}"
                            Height="26" FontSize="11" Padding="10,2" Margin="8,0,0,0"
                            Visibility="Collapsed" Click="Skip_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 已注册：好友 / 群聊 -->
        <Grid x:Name="FriendsRoot" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="268" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0" Padding="14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="9" ClipToBounds="True"
                                    Background="{DynamicResource SurfaceAltBrush}">
                                <Image x:Name="SelfAvatar" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="SelfNameText" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock x:Name="SelfEmailText" FontSize="10"
                                           Foreground="{DynamicResource MutedBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="我的启动器 ID" Style="{StaticResource Section}" Margin="0,12,0,4" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="MyIdText" Text="RX-······" FontFamily="Consolas"
                                       FontSize="13" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}" />
                            <Button Content="复制" Style="{StaticResource GhostButton}" Height="24"
                                    FontSize="11" Padding="8,1" Margin="8,0,0,0" Click="CopyMyId_Click" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBox x:Name="FriendIdBox" Style="{StaticResource InputBox}" Height="26"
                                     FontSize="11" ToolTip="输入对方的 RX-XXXXXX" />
                            <Button Content="加好友" Style="{StaticResource GhostButton}" Height="26"
                                    FontSize="11" Padding="8,1" Margin="6,0,0,0" Click="AddById_Click" />
                        </StackPanel>

                        <TextBlock Text="云好友" Style="{StaticResource Section}" Margin="0,10,0,4" />
                        <TextBlock x:Name="CloudEmptyText" Style="{StaticResource Muted}" FontSize="10"
                                   Text="还没有云好友：把上面的 ID 给对方，或者输入对方的 ID" />
                        <StackPanel x:Name="CloudList" />

                        <TextBlock Text="局域网好友" Style="{StaticResource Section}" Margin="0,10,0,6" />
                        <TextBlock x:Name="NoPeerText" Style="{StaticResource Muted}" FontSize="11"
                                   Text="同一局域网内已注册的设备会自动出现" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Button Content="新建群聊" Style="{StaticResource GhostButton}" Height="30"
                                HorizontalAlignment="Stretch" Click="NewGroup_Click" />
                        <TextBlock x:Name="SelfText" Style="{StaticResource Muted}" Margin="0,8,0,0" FontSize="10" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <StackPanel>
                            <StackPanel x:Name="PeerList" />
                            <TextBlock Text="群聊" Style="{StaticResource Section}" Margin="0,14,0,6" />
                            <StackPanel x:Name="GroupList" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock x:Name="ChatTitle" Text="未选择会话" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock x:Name="ChatSubtitle" Style="{StaticResource Muted}" FontSize="11"
                                   Text="点左侧好友开始聊天，或新建一个群聊" />
                    </StackPanel>

                    <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="InputBox" Style="{StaticResource InputBox}" Height="34"
                                 VerticalContentAlignment="Center" Margin="0,0,8,0"
                                 KeyDown="InputBox_KeyDown" />

                        <Button Grid.Column="1" Content="图片" Style="{StaticResource GhostButton}" Height="34"
                                Margin="0,0,8,0" Click="SendImage_Click" />
                        <Button Grid.Column="2" Content="发送" Style="{StaticResource PrimaryButton}" Height="34"
                                Click="Send_Click" />
                    </Grid>

                    <ScrollViewer x:Name="MessageScroll" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="MessagePanel" Margin="0,4,0,0" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
