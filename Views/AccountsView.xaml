<UserControl x:Class="RxNeL.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DockPanel>

        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="添加账号" Style="{StaticResource Section}" Margin="0,0,0,8" />

                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="UsernameBox" Style="{StaticResource InputBox}" Width="200" Height="30"
                             Margin="0,0,8,0" ToolTip="Roblox 用户名（不是显示名）" />
                    <PasswordBox x:Name="PasswordBox" Style="{StaticResource InputPassword}" Width="200" Height="30"
                                 Margin="0,0,8,0" ToolTip="只在本机加密保存，不上传、不校验" />
                    <Button Content="验证并保存" Style="{StaticResource PrimaryButton}" Height="30"
                            Click="Add_Click" />
                </StackPanel>

                <TextBlock x:Name="AddStatus" Style="{StaticResource Muted}" Margin="0,10,0,0"
                           Text="用户名会去 Roblox 查证（不存在则拒绝添加）；密码不做任何验证，只用 Windows DPAPI 加密后存本机。" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="重新验证用户名" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Verify_Click" />
                <Button Content="删除" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Delete_Click" />
                <Button Content="复制用户名" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Copy_Click" />
                <Button x:Name="TogglePasswordButton" Content="显示密码" Style="{StaticResource GhostButton}"
                        Margin="0,0,8,0" Click="TogglePassword_Click" />
                <Button Content="复制密码" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="CopyPassword_Click" />
                <Button Content="打开数据目录" Style="{StaticResource GhostButton}" Click="OpenDir_Click" />
                <TextBlock x:Name="SelectedPasswordText" FontFamily="Consolas" FontSize="12"
                           VerticalAlignment="Center" Margin="6,0,12,0"
                           Foreground="{DynamicResource TextBrush}" Text="密码：—" />

                <TextBlock x:Name="ListStatus" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Border x:Name="AvatarCard" DockPanel.Dock="Right" Style="{StaticResource Card}"
                Width="220" Margin="12,0,0,0" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="头像" Style="{StaticResource Section}" Margin="0,0,0,8" />
                <Border Width="176" Height="176" CornerRadius="12"
                        Background="{DynamicResource SurfaceAltBrush}" ClipToBounds="True">
                    <Image x:Name="AvatarImage" Stretch="UniformToFill" />
                </Border>
                <TextBlock x:Name="AvatarStatus" Style="{StaticResource Muted}" Margin="0,8,0,0"
                           Text="选中一个账号后加载（Roblox 公开缩略图接口）" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="已记录账号" Style="{StaticResource Section}" Margin="0,0,0,8" />

                <ListView x:Name="AccountList" Background="Transparent" BorderThickness="0"
                          Foreground="{DynamicResource TextBrush}"
                          SelectionChanged="AccountList_SelectionChanged">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="用户名" Width="128" DisplayMemberBinding="{Binding Username}" />
                            <GridViewColumn Header="显示名" Width="118" DisplayMemberBinding="{Binding DisplayName}" />
                            <GridViewColumn Header="ID" Width="90" DisplayMemberBinding="{Binding UserIdText}" />
                            <GridViewColumn Header="状态" Width="112" DisplayMemberBinding="{Binding Status}" />
                            <GridViewColumn Header="更新时间" Width="82" DisplayMemberBinding="{Binding UpdatedText}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Border>

    </DockPanel>
</UserControl>
