<UserControl x:Class="RxNeL.Views.LaunchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">

            <TextBlock x:Name="StatusText"
                       Text="准备就绪"
                       FontSize="13"
                       Foreground="{DynamicResource MutedBrush}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,22" />

            <Button x:Name="LaunchButton"
                    Content="启动 Roblox"
                    Style="{StaticResource HeroButton}"
                    Width="360" Height="84"
                    HorizontalAlignment="Center"
                    Click="LaunchButton_Click" />

            <CheckBox x:Name="MultiInstanceCheck"
                      Content="多开模式"
                      Style="{StaticResource BigCheck}"
                      HorizontalAlignment="Center"
                      Margin="0,30,0,0" />

            <TextBlock x:Name="HintText"
                       Text="启动前会自动检查客户端版本、写入 FastFlags、应用模组与字体"
                       FontSize="11"
                       Foreground="{DynamicResource MutedBrush}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,16,0,0" />

        </StackPanel>
    </Grid>
</UserControl>
