<UserControl x:Class="RxNeL.Views.ModsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource Card}">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="模组文件" Style="{StaticResource Section}" Margin="0,0,0,10" />

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="打开模组目录" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Open_Click" />
                <Button Content="刷新列表" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Refresh_Click" />
                <Button Content="应用模组到客户端" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="Apply_Click" />
                <Button Content="还原原始文件" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Restore_Click" />
                <Button Content="清空模组目录" Style="{StaticResource GhostButton}" Click="Clear_Click" />
            </StackPanel>

            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" Margin="0,10,0,0"
                       Text="目录结构与客户端版本目录一致（如 content\textures\xxx.png）。覆盖前原文件备份为 *.rbxlite.bak；客户端更新换目录后需重新应用。" />

            <TextBox x:Name="ListBox" Style="{StaticResource InputBox}" IsReadOnly="True"
                     AcceptsReturn="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" />
        </DockPanel>
    </Border>
</UserControl>
