<Window x:Class="RxNeL.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rx | NeL HUD"
        Width="286" Height="132"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        MouseLeftButtonDown="OnDrag">

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="12" Padding="14,12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource AccentBrush}"
                    VerticalAlignment="Top">
                <TextBlock Text="Rx" FontSize="12" FontWeight="Bold"
                           Foreground="{DynamicResource AccentTextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <TextBlock x:Name="VersionText" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" Text="客户端：—" />
                <TextBlock x:Name="MultiText" FontSize="11" Margin="0,3,0,0"
                           Foreground="{DynamicResource MutedBrush}" Text="多开：关" />
                <TextBlock x:Name="AccountText" FontSize="11" Margin="0,2,0,0"
                           Foreground="{DynamicResource MutedBrush}" Text="账号：0" />
                <TextBlock x:Name="UptimeText" FontSize="10" Margin="0,4,0,0" FontFamily="Consolas"
                           Foreground="{DynamicResource MutedBrush}" Text="运行 00:00" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
